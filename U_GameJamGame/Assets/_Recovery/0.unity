--- !u!114 &22771206
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 22771202}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9dbdf8d79232f9f4abe8f8cc0b61f4c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SuspectNPC
  canInteract: 1
  interactText: Amanda Petrov
  defaultSprite: {fileID: 21300000, guid: 981a4d6cfb81b6d46acb6ee7b198dbf5, type: 3}
  guiltySprite: {fileID: 21300000, guid: 9101fed03d430094197944cb5d34dac6, type: 3}
  startDialogueUid: A01
  dialogueNPC:
  - UID: 
    npcText: 
    options: []
  dialogues:
  - guiltyNPC: {fileID: 1667740226}
    dialogue:
    - UID: A01
      npcText: O-oi... tio detetive....
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "\u2026\u2026\u2026\u2026 \u2026\u2026\u2026\u2026\u2026\u2026\u2026
        N\xE3o sei."
      options:
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Eu\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.. ela era\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.
        eu tinha medo\u2026\u2026\u2026.. e\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.."
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Eu\u2026\u2026\u2026.. eu vi. O Triste, ele estava l\xE1."
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 462758012}
    dialogue:
    - UID: A01
      npcText: "Eu... \xE9... Oi?"
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Eu... eu estava l\xE1 em cima... no meu esconderijo..."
      options:
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Ela n\xE3o \xE9 muito gentil."
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Vi o Palha\xE7o... ele n\xE3o estava feliz... ele subiu as escadas
        bem r\xE1pido..."
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 1358348719}
    dialogue:
    - UID: A01
      npcText: ....
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Eu... estava no meu lugar... l\xE1 em cima..."
      options:
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Ela era m\xE1... muito m\xE1..."
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: A Sombra... ela subiu... vi ela subindo as escadas...
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 957469445}
    dialogue:
    - UID: A01
      npcText: Eu acho que nunca mais vou conseguir dormir
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: Eu... sim... eu vi...
      options:
      - optionText: "Como era sua rela\xE7\xE3o com Joanna?"
        UIDNextDialogue: A03
      - optionText: "Voc\xEA viu alguma atitude estranha da parte dela nesses \xFAltimos
          dias?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Ela era m\xE1... muito m\xE1 comigo..."
      options:
      - optionText: "Crian\xE7a, voc\xEA viu o que aconteceu?"
        UIDNextDialogue: A02
