      - optionText: "Voc\xEA viu alguma atitude estranha da parte de algu\xE9m nesses
          \xFAltimos dias?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "\u2026\u2026\u2026\u2026\u2026\u2026."
      options:
