--- !u!114 &1667740226
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1667740220}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9dbdf8d79232f9f4abe8f8cc0b61f4c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SuspectNPC
  canInteract: 1
  interactText: Don Genaro
  guiltySprite: {fileID: 21300000, guid: 2e7733aa532184e4d8620a52303beb8d, type: 3}
  startDialogueUid: A01
  dialogueNPC:
  - UID: A01
    npcText: Boa noite, detetive
    options:
    - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
      UIDNextDialogue: A02
    - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
      UIDNextDialogue: A03
    - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte de
        qualquer outro membro do elenco? "
      UIDNextDialogue: A04
  - UID: A02
    npcText: No banheiro. Sempre no maldito banheiro.
    options:
    - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
      UIDNextDialogue: A03
    - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte de
        qualquer outro membro do elenco? "
      UIDNextDialogue: A04
  - UID: A03
    npcText: "Horr\xEDvel. Escutei ela falando coisas horr\xEDveis da minha fam\xEDlia
      pras bailarinas cobras que andam do lado dela. Pelo menos agora n\xE3o tenho
      que aguentar aquela mocreia. "
    options:
    - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
      UIDNextDialogue: A02
    - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte de
        qualquer outro membro do elenco? "
      UIDNextDialogue: A04
  - UID: A04
    npcText: "Ouvi algu\xE9m vagando pelos corredores, murmurando. O teatro deixa
      as pessoas loucas. "
    options:
    - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
      UIDNextDialogue: A02
    - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
      UIDNextDialogue: A03
  dialogues:
  - guiltyNPC: {fileID: 1667740226}
    dialogue:
    - UID: A01
      npcText: Fala logo
      options:
      - optionText: "Como voc\xEA conhece a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "O que voc\xEA estava fazendo antes da abertura das cortinas? "
        UIDNextDialogue: A03
      - optionText: "Qual a rela\xE7\xE3o entre Joanna e sua esposa? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: "N\xE3o quero falar sobre nada disso. Meus filhos me esperam em casa.
        Me deixe ir, por favor. "
      options:
      - optionText: "O que voc\xEA estava fazendo antes da abertura das cortinas? "
        UIDNextDialogue: AG03
      - optionText: "Qual a rela\xE7\xE3o entre Joanna e sua esposa? "
        UIDNextDialogue: AG04
    - UID: A03
      npcText: "Estava fazendo exerc\xEDcios vocais com Afonso. Ele sempre me ajuda
        com meus treinamentos. Est\xE1vamos em meu camarim "
      options:
      - optionText: "Como voc\xEA conhece a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Qual a rela\xE7\xE3o entre Joanna e sua esposa? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "N\xE3o sei nada sobre isso."
      options:
      - optionText: "Como voc\xEA conhece a v\xEDtima? "
        UIDNextDialogue: AG02
      - optionText: "O que voc\xEA estava fazendo antes da abertura das cortinas? "
        UIDNextDialogue: AG03
  - guiltyNPC: {fileID: 462758012}
    dialogue:
    - UID: A01
      npcText: Boa noite, camarada
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Estava no banheiro. Precisava me acalmar depois de uma discuss\xE3o
        com Joanna. Ela disse coisas terr\xEDveis sobre Maria... sobre minha esposa
        falecida. "
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: AG03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: AG04
    - UID: A03
      npcText: "P\xE9ssima. Ela destruiu minha vida. Mas meus filhos precisam de
        mim, ent\xE3o n\xE3o posso fazer nada imprudente. "
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Afonso estava furioso hoje. Nunca o vi assim. Ele \xE9 sempre t\xE3o
        alegre, mas Joanna o humilhou na frente de todos."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: AG02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima?"
        UIDNextDialogue: AG03
  - guiltyNPC: {fileID: 1358348719}
    dialogue:
    - UID: A01
      npcText: Boa noite, detetive
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: "No banheiro. A Joanna me tira do s\xE9rio quando pisa no meu p\xE9
        no palco. Ela fazia isso de prop\xF3sito."
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Terr\xEDvel. Mas todos sabem disso. Eu tenho meus motivos. "
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "As discuss\xF5es foram mais frequentes com Viktoria no m\xEAs passado,
        mas parece que est\xE1 tudo bem agora. At\xE9 pessoas calmas estavam perdendo
        a compostura."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 957469445}
    dialogue:
    - UID: A01
      npcText: Boa noite, camarada
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: No banheiro. Sempre no maldito banheiro.
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Horr\xEDvel. Escutei ela falando coisas horr\xEDveis da minha fam\xEDlia
        pras bailarinas cobras que andam do lado dela. Pelo menos agora n\xE3o tenho
        que aguentar aquela mocreia."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Ouvi algu\xE9m vagando pelos corredores, murmurando. O teatro deixa
        as pessoas loucas."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 22771206}
    dialogue:
    - UID: A01
      npcText: Boa noite, camarada
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
    - UID: A02
      npcText: No banheiro
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
    - UID: A03
      npcText: "P\xE9ssima. Todos sabem disso. Ela destruiu minha vida e matou minha
        mulher\u2026 Mas ninguem ficou do meu lado. Traidores. Agora ela est\xE1
        morta, at\xE9 que enfim. "
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
    - UID: A04
      npcText: "Sei l\xE1, mal vi Joanna essa semana. Estava ocupado ensaiando minhas
        falas, diferente de alguns aqui."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas?"
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
