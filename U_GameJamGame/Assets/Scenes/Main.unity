  m_GameObject: {fileID: 462758008}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9dbdf8d79232f9f4abe8f8cc0b61f4c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SuspectNPC
  canInteract: 1
  interactText: Afonso Pobinski
  guiltySprite: {fileID: 21300000, guid: 8291089cbb98f2447b2339624ca757f8, type: 3}
  startDialogueUid: A01
  dialogueNPC:
  - UID: S01
    npcText: Bom dia senhor...
    options:
    - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
      UIDNextDialogue: S02
    - optionText: "Como era sua conviv\xEAncia com a v\xEDtima?"
      UIDNextDialogue: S03
    - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte de
        qualquer outro membro do elenco? "
      UIDNextDialogue: S04
  - UID: S02
    npcText: "Eu estava nas coxias, costurando a manga que Joanna rasgou. Sabe\u2026
      eu sinto muito pela morte de nossa colega, mas devo confessar que ela deixava
      o ambiente do teatro muito pesado. \xC9 como se uma pedra fosse tirada das
      minhas costas "
    options:
    - optionText: "Como era sua conviv\xEAncia com a v\xEDtima?"
      UIDNextDialogue: S03
    - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte de
        qualquer outro membro do elenco? "
      UIDNextDialogue: S04
  - UID: S03
    npcText: "Eu e Joanna n\xE3o \xE9ramos pr\xF3ximos. Ela n\xE3o gostava de mim,
      mas eu n\xE3o tenho nada contra ela. "
    options:
    - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
      UIDNextDialogue: S02
    - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte de
        qualquer outro membro do elenco? "
      UIDNextDialogue: S04
  - UID: S04
    npcText: "N\xE3o me leve a mal, mas Joanna n\xE3o tinha muitos amigos. Ela era
      cruel com todos do elenco. Estou feliz que n\xE3o tenho mais que lidar com
      isso. "
    options:
    - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
      UIDNextDialogue: S02
    - optionText: "Como era sua conviv\xEAncia com a v\xEDtima?"
      UIDNextDialogue: S03
  dialogues:
  - guiltyNPC: {fileID: 1667740226}
    dialogue:
    - UID: A01
      npcText: Bom dia senhor..
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Eu estava nas coxias, costurando a manga que Joanna rasgou. Sabe\u2026
        eu sinto muito pela morte de nossa colega, mas devo confessar que ela deixava
        o ambiente do teatro muito pesado. \xC9 como se uma pedra fosse tirada das
        minhas costas "
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Eu e Joanna n\xE3o \xE9ramos pr\xF3ximos. Ela n\xE3o gostava de mim,
        mas eu n\xE3o tenho nada contra ela."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "N\xE3o me leve a mal, mas Joanna n\xE3o tinha muitos amigos. Ela
        era cruel com todos do elenco. Estou feliz que n\xE3o tenho mais que lidar
        com isso."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 1667740226}
    dialogue:
    - UID: A01
      npcText: Bom dia senhor..
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Estava terminando de costurar minha manga. Fiquei no camarim at\xE9
        o \xFAltimo momento. "
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: 'Sempre tentei ser gentil com todos, inclusive com ela. '
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Joanna rasgou de prop\xF3sito. Disse que eu roubaria a aten\xE7\xE3o
        dela. Depois de tudo que fa\xE7o para alegrar este lugar..."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 1358348719}
    dialogue:
    - UID: A01
      npcText: "Ol\xE1, amig\xE3o"
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: 'Estava nas coxias, costurando minha manga que Joanna rasgou. '
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Ela n\xE3o gostava de mim. Mas eu tentava manter a paz, como fa\xE7o
        com todo mundo. Fazer as pessoas rirem \xE9 dif\xEDcil, sabe? "
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Vi algu\xE9m saindo do corredor que leva ao palanque. Parecia apressado."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 957469445}
    dialogue:
    - UID: A01
      npcText: "Ol\xE1, amig\xE3o"
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: 'Nas coxias, costurando minha manga. '
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Ela me odiava. Dizia que eu roubava a aten\xE7\xE3o dela. Uma chata,
        mas o p\xFAblico ama ela. Sinto falta da Maria. "
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Tem gente aqui que est\xE1 perdendo o controle. Joanna estava aumentando
        a press\xE3o nos camarins. Motivos para todos n\xE3o faltam. Mas eu jamais
        faria isso. "
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 22771206}
    dialogue:
    - UID: A01
      npcText: "Sou seu amig\xE3oz\xE3o"
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Nas coxias, costurando a manga que a Joanna rasgou antes da pe\xE7a.
        Ela era uma alma perversa."
      options:
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Ela me odiava, s\xF3 porque divertia mais a plat\xE9ia. Espero que
        tenha encontrado paz, onde quer que esteja."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Houve alguma intera\xE7\xE3o preocupante com Joanna da parte
          de qualquer outro membro do elenco? "
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Os ataques estavam piores. At\xE9 as crian\xE7as estavam sofrendo
        mais que o normal."
      options:
      - optionText: "Onde voc\xEA estava no momento da abertura das cortinas? "
        UIDNextDialogue: A02
      - optionText: "Como era sua conviv\xEAncia com a v\xEDtima? "
        UIDNextDialogue: A03
