  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9dbdf8d79232f9f4abe8f8cc0b61f4c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SuspectNPC
  canInteract: 1
  interactText: "Vikt\xF3ria Valencia"
  defaultSprite: {fileID: 21300000, guid: 3c5dbd48da091d44b90c780f52caa947, type: 3}
  guiltySprite: {fileID: 21300000, guid: c5a0e2b70d658964185ce628c7a69a5b, type: 3}
  startDialogueUid: A01
  dialogueNPC:
  - UID: S01
    npcText: Viktoria, a seu dispor
    options:
    - optionText: "Voc\xEA era prima da v\xEDtima\u2026 Como era sua rela\xE7\xE3o
        com ela? "
      UIDNextDialogue: S02
    - optionText: "Com quem voc\xEA estava antes do acontecimento?"
      UIDNextDialogue: S03
    - optionText: "Entre n\xF3s, voc\xEA suspeita de algu\xE9m?"
      UIDNextDialogue: S04
  - UID: S02
    npcText: "\xC9ramos pr\xF3ximas na inf\xE2ncia. Nos afastamos quando adultas."
    options:
    - optionText: "Com quem voc\xEA estava antes do acontecimento?"
      UIDNextDialogue: S03
    - optionText: "Entre n\xF3s, voc\xEA suspeita de algu\xE9m?"
      UIDNextDialogue: S04
  - UID: S03
    npcText: Estava aquecendo a voz em meu camarim. Estava sozinha.
    options:
    - optionText: "Voc\xEA era prima da v\xEDtima\u2026 Como era sua rela\xE7\xE3o
        com ela? "
      UIDNextDialogue: S02
    - optionText: "Entre n\xF3s, voc\xEA suspeita de algu\xE9m?"
      UIDNextDialogue: S04
  - UID: S04
    npcText: "N\xE3o tenho nenhuma id\xE9ia de quem possa ter feito isso. Mas \xE9
      o Lindolf que tem as chaves do palanque."
    options:
    - optionText: "Voc\xEA era prima da v\xEDtima\u2026 Como era sua rela\xE7\xE3o
        com ela? "
      UIDNextDialogue: S02
    - optionText: "Com quem voc\xEA estava antes do acontecimento?"
      UIDNextDialogue: S03
  dialogues:
  - guiltyNPC: {fileID: 1793904352}
    dialogue:
    - UID: A01
      npcText: 'Hum... '
      options:
      - optionText: "Voc\xEA era prima da v\xEDtima\u2026 Como era sua rela\xE7\xE3o
          com ela?"
        UIDNextDialogue: A02
      - optionText: "Com quem voc\xEA estava antes do acontecimento?"
        UIDNextDialogue: A03
      - optionText: "Entre n\xF3s, voc\xEA suspeita de algu\xE9m?"
        UIDNextDialogue: A04
