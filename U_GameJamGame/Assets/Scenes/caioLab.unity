--- !u!114 &1983712568
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1983712567}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9dbdf8d79232f9f4abe8f8cc0b61f4c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SuspectNPC
  canInteract: 1
  interactText: 'Lindolf Monde '
  defaultSprite: {fileID: 21300000, guid: f8f58793a54c13d45a1fc2ccfadc1888, type: 3}
  guiltySprite: {fileID: 21300000, guid: a4918f1001200924bbca89322dd2fa6f, type: 3}
  startDialogueUid: A01
  dialogueNPC:
  - UID: 
    npcText: 
    options: []
  dialogues:
  - guiltyNPC: {fileID: 1983712568}
    dialogue:
    - UID: A01
      npcText: "... \xC9 melhor voc\xEA ir embora"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Ela era... snif... a antagonista... toda hist\xF3ria precisa de uma...
        e toda trag\xE9dia precisa de um cl\xEDmax... "
      options:
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "\xC9 uma tragedia\u2026. "
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Sim... snif... as chaves sempre estiveram comigo... eu protejo o
        palanque... \xE9 minha responsabilidade... "
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 1793904352}
    dialogue:
    - UID: A01
      npcText: "... O que voc\xEA quer?"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "Somos colegas\u2026\u2026. snif\u2026\u2026. oh Deus, quem faria
        isso\u2026\u2026\u2026.. snif. Ela era apenas meio cruel\u2026\u2026 N\xE3o
        merecia morrer\u2026.. oh mundo cruel\u2026.. "
      options:
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Estou perplexo\u2026.. snif\u2026\u2026\u2026\u2026\u2026\u2026\u2026.
        Nunca vi ningu\xE9m morrer\u2026.."
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Elas est\xE3o bem\u2026\u2026\u2026. \u2026\u2026 Oh n\xE3o! Onde
        est\xE3o minhas chaves? Elas sumiram!"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 586317613}
    dialogue:
    - UID: A01
      npcText: "... O que voc\xEA quer?"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: "\xC9ramos colegas... snif... ela era dura comigo, mas n\xE3o merecia
        isso... "
      options:
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "\xC9 tudo t\xE3o triste... a morte, a trag\xE9dia... \xE9 como meu
        personagem..."
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Sim, est\xE3o aqui... espere... falta uma! A reserva que fica no
        camarim sumiu!"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 751604562}
    dialogue:
    - UID: A01
      npcText: "Como posso ser \xFAtil?"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: Colegas... snif... apenas colegas...
      options:
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "A morte \xE9 t\xE3o triste... afinal..."
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Sim, est\xE3o aqui. Espere... algu\xE9m pegou a reserva ontem. Disseram
        que precisavam verificar algo no sistema de cordas. N\xE3o lembro quem foi."
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 194282117}
    dialogue:
    - UID: A01
      npcText: "... O que voc\xEA quer?"
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A02
      npcText: Colegas... snif... apenas isso..
      options:
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A03
      npcText: "Tudo \xE9 t\xE3o triste... snif..."
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Ouvi dizer que voc\xEA \xE9 o respons\xE1vel pelas chaves do
          palanque superior. Voc\xEA as tem?"
        UIDNextDialogue: A04
    - UID: A04
      npcText: "Est\xE3o aqui... espere... a c\xF3pia reserva sumiu! Algu\xE9m que
        conhece bem o palanque poderia ter pegado..."
      options:
      - optionText: "Qual era sua rela\xE7\xE3o com a v\xEDtima? "
        UIDNextDialogue: A02
      - optionText: "Por que est\xE1 chorando? "
        UIDNextDialogue: A03
