        UIDNextDialogue: A03
  - guiltyNPC: {fileID: 1983712568}
    dialogue:
    - UID: A01
      npcText: Fale.
      options:
      - optionText: "Voc\xEA era prima da v\xEDtima\u2026 Como era sua rela\xE7\xE3o
